            }

            .btn-outline {
                padding-inline: 47px;
            }
        }
    }

    .slack {
        margin: 140px 0;

        .pre-heading {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: 24px;
            text-transform: uppercase;
            color: #EB38CF;
            margin-bottom: 29px;
        }

