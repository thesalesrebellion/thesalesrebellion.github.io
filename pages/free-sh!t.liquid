{% include 'header.liquid' %}

<div class="page-{{ page_id }} font-kufam">
    <div class="hero">
        <div class="container-wide">
            <h1 class="font-horsemen">{{ title }}</h1>
            <p class="sub-heading">
                Need help with your sales walk? Don't have budget for playbooks or training? Check out the resources below! 
            </p>
        </div>
    </div>
    <div class="container-wide">
        <div class="podcast d-flex align-items-stretch">
            <div class="img-container d-flex">
                <img src="/img/free-sh!t/chat-bubble.webp" alt="" class="absolute">
                <img src="/img/home/dale-cartoon.webp" alt="Dale cartoon">
            </div>
            <div class="box text-center">
                <img src="/img/svg/pixel-volume-3.svg" alt="speaker icon">
                <h2>Selling Local Podcast</h2>
                <p>
                    For every Rebel just getting started in sales, or just getting to know The Rebellion... We highly recommend our OG podcast - Selling Local. Start from the beginning (Episode 0) and take the journey with us!
                </p>
                <a class="btn btn-outline" href="https://open.spotify.com/show/6vggsDkQyAuOgsUciBNj9E?si=oxvbB8VNTbO98ZIsPW7tkw&nd=1&dlsi=eee1bc8a483f4b4c" target="_blank">Click Here to Listen</a>
            </div>
        </div>
        <div class="slack text-center">
            <p class="pre-heading">Rebel Slack Channel</p>
            <h2 class="font-horsemen">Come Hang Out With Us</h2>
            <div class="box d-flex align-items-center">
                <div class="img-container">
                    <img src="/img/free-sh!t/rebel-refuge-logo.webp" alt="Rebel Refuge logo">
                </div>
                <div class="text-container">
                    <h3>Our Rebel Refuge</h3>
                    <p>
                        This is our FREE community option for anyone who wants to engage with the Rebel Family, get advice, ask questions, see content from the Rebel Leader and learn more about how to turn your life and sales into the most Rebellious thing on planet earth.
                    </p>
                    <a href="https://thesalesrebellion.typeform.com/to/frAJUfW6" target="_blank" class="btn btn-pink">Click Here to Join</a>
                </div>
            </div>
        </div>
    </div>
    <div class="rebel-blog text-center">
        <div class="container-wide">
            <h2 class="font-horsemen">The Rebel Blog</h2>
            <p>
                Learn how to sell more and suck less with these tailored articles written for Rebels of all sizes that are looking to better understand how to change the game in their sales career. Read more on: how to prospect better, how to communicate better, how to differentiate yourself, how to break through the noise, how to close more sales and so much more!
            </p>
            <div class="free-shit-blog-slider d-flex align-items-stretch">
                <!-- Temporary until blog launches -->
                {% for blog in blog_posts %}
                <div class="slide d-flex">
                    <div class="img-container">
                        <img class="d-none d-sm-block" src="{{ blog.image }}" alt="{{ blog.title }}">
                        <img class="d-block d-sm-none" src="{{ blog.image_mobile }}" alt="{{ blog.title }}">
                    </div>
                    <div class="text-container">
                        <!-- <p class="tag">{{ blog.tag}}</p> -->
                        <h3>{{ blog.title }}</h3>
                        <p>{{ blog.description }}</p>
                        <a href="{{ blog.url }}" class="btn btn-arrow d-flex align-items-center {%if blog.coming_soon %} disabled {% endif %}">
                            <span>Coming Soon</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path d="M4 11V13H16V15H18V13H20V11H18V9H16V11H4ZM14 7H16V9H14V7ZM14 7H12V5H14V7ZM14 17H16V15H14V17ZM14 17H12V19H14V17Z" fill="#FF00FF"/>
    </svg>
                        </a>
                    </div>
                </div>
                {% endfor %}
            </div>
            <!-- Hidden until blog launches -->
            <!-- <a href="/blog" class="btn btn-pink">Check Out The Rebel Blog</a> -->
        </div>
    </div>
</div>
