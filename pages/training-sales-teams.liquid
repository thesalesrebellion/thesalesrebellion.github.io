{% include 'header.liquid' %}

<div class="page-{{ page_id }} training font-kufam">
    <h1>Training for Sales Teams</h1>
    <div class="container-wide">
        <div class="cards-container d-flex flex-column flex-lg-row align-items-stretch">
            {% for card in cards %}
                <div class="card d-flex flex-column align-items-center font-kufam">
                    <img src="{{ card.icon }}" alt="{{ card.title }} Icon">
                    <h2 class="text-center">{{ card.title }}</h2>
                    <p class="text-center">{{ card.text }}</p>
                    <a href="{{ card.btn_link }}" class="btn btn-outline w-100 mt-auto" {% if card.new_tab %}target="_blank"{% endif %}>{{ card.btn_text }}</a>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
  