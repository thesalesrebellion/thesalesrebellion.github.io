        background-position-y: top;
        background-repeat: no-repeat;

        h2 {
            font-size: 2.75rem;
            letter-spacing: 6.16px;
            color: #F0F;
            margin-bottom: 40px;
        }

        p {
            font-size: 1.25rem;
            font-weight: 500;
            line-height: 150%;
            margin-bottom: 80px;
        }

        .free-shit-blog-slider {
            margin-left: -10px;
            margin-bottom: 110px;

                .slick-track {
                    display: flex;
                    align-items: stretch;

                    .slick-slide {
                        height: auto;
                    }
                }

                .slick-next,
                .slick-prev {
                    top: calc(100% + 30px);
                    width: 40px;
                    height: 40px;

                    &.slick-disabled {
                        opacity: 0.3;
                        pointer-events: none;
                    }
                }

                .slick-prev {
                    left: 50%;
                    transform: translateX(-52px);
                }
                
                .slick-next {
                    right: 50%;
                    transform: translateX(52px);
                }

                .slick-prev:hover path,
                .slick-next:hover path {
                    fill: #EB38CF;
                }
                
                .slick-prev:hover rect,
                .slick-next:hover rect {
                    stroke: #EB38CF;
                }

            .slide {
                padding: 28px;
                border: 1.5px solid #647488;
                background: transparent;
                gap: 24px;
                text-align: left;
                height: auto;
                min-width: 465px;
                margin-inline: 10px;
                flex-direction: column;

                img {
                    width: 100%;
                    height: auto;
                    box-shadow: 0 6px 12px 0 rgba(235, 56, 207, 0.16);
                }

                .text-container {
                    display: flex;
                    flex-direction: column;
                    gap: 24px;

                    h3 {
                        color: #66FFC8;
                        font-size: 1.25rem;
                        font-weight: 700;
                        margin-bottom: 0;
                    }
    
                    p {
                        font-size: 1rem;
                        line-height: 150%;
                        font-weight: 500;
                        margin-bottom: 0;
    
                        &.tag {
                            color: #FFA6FF;
                            font-size: 0.875rem;
                            font-weight: 600;
                        }
                    }
    
                    a {
                        font-size: 1rem;
                        color: #F0F;
                    }
                }

            }
        }
    }

