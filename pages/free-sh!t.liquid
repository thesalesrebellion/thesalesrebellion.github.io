        font-family: Kufam, sans-serif;
        font-size: 1.125rem;
        line-height: 1;
        letter-spacing: unset;

        &:hover {
            box-shadow: none;
            text-shadow: none;
        }
        
        &.btn-pink {
            color: #fff;
            background-color: #EB38CF;
            border: 3px solid #EB38CF;
            font-weight: 700;

            &:hover {
                background-color: #ff59ff;
                border-color: #ff59ff;
            }
        }

        &.btn-outline {
            color: #66FFC8;
            background-color: transparent;
            border: 3px solid #EB38CF;
            font-weight: 400;

            &:hover {
                background: #66ffc8;
                border: 3px solid #66ffc8;
                color: #000;
            }
        }

        &.btn-arrow {
            padding: 0;
            gap: 8px;

            &:hover {
                svg {
                    transform: translateX(10px);
                    transition: all 0.3s ease;
                }
            }
        }
    }

    .hero {
        background-image: url('/img/free-sh!t/synthwave-mountain.webp');
