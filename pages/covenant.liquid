      - text: Online Community Access
        icon: /img/svg/pixel-check-pink.svg
      - text: Monthly Virtual Learning - Led by Dale Dupree
        icon: /img/svg/pixel-check-pink.svg
      - text: Monthly Networking Event (virtual)
        icon: /img/svg/pixel-check-pink.svg
      - text: Monthly Creative Selling Workshops (virtual)
        icon: /img/svg/pixel-check-pink.svg
      - text: In-person Micro Event (March)
        icon: /img/svg/pixel-check-pink.svg
      - text: In-person Micro Event (June)
