---
title: Individual Sellers
layout: default
layout_engine: bootstrap
permalink: /individual-sellers/
page_id: individual-sellers
landing_page: false
cards:
    - title: "Monthly Membership Program"
      text: "Rebel-worthy training that’s as easy on your wallet as it is hard on your competition."
      btn_link: "/covenant/"
      btn_text: "Click Here to Learn More"
      new_tab: false
      icon: "/img/svg/pixel-user.svg"
    - title: "Private Sales Coaching"
      text: "Our private sales training is as effective as it is expensive. You may need to consider refinancing your mortgage to secure this service. Don’t worry, we’re mostly joking."
      btn_link: "/advisory/"
      btn_text: "Click Here to Learn More"
      new_tab: false
      icon: "/img/svg/pixel-bullseye-arrow.svg"
---

{% include 'header.liquid' %}

<div class="page-{{ page_id }} training font-kufam">
    <h1>Training for Individual Sellers</h1>
    <div class="container-wide">
        <div class="cards-container d-flex flex-column flex-lg-row align-items-stretch">
            {% for card in cards %}
                <div class="card-2 d-flex flex-column align-items-center font-kufam">
                    <img src="{{ card.icon }}" alt="{{ card.title }} Icon">
                    <h2 class="text-center">{{ card.title }}</h2>
                    <p class="text-center">{{ card.text }}</p>
                    <a href="{{ card.btn_link }}" class="btn btn-outline w-100 mt-auto" {% if card.new_tab %}target="_blank"{% endif %}>{{ card.btn_text }}</a>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
  